---
import SectionHeading from './SectionHeading.astro';
import { config } from '../site.config';

const { embedUrl, linkUrl } = config.planer;
---

<section id="planer" class="border-b border-border bg-sky py-[var(--spacing-section)]">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <SectionHeading
      eyebrow="PLANER"
      title="PLANER を体験する"
      lead="紹介先にそのまま見せられるインタラクティブなPLANERを、この場でご覧いただけます。"
    />

    <div class="reveal mt-12">
      {
        embedUrl ? (
          <div class="overflow-hidden rounded-image border border-border bg-white shadow-feature">
            <div class="aspect-[16/10] w-full md:aspect-[16/9]">
              <iframe
                src={embedUrl}
                title="PLANER"
                class="h-full w-full"
                loading="lazy"
                allow="fullscreen; clipboard-write"
                referrerpolicy="no-referrer-when-downgrade"
              />
            </div>
          </div>
        ) : (
          <div class="rounded-image border border-dashed border-hairline bg-white px-6 py-20 text-center text-ash">
            PLANER 埋め込み枠
          </div>
        )
      }

      {
        linkUrl && (
          <div class="mt-6">
            <a
              href={linkUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 rounded-input border border-action px-6 py-3 text-[14px] font-medium text-action transition-colors hover:bg-action hover:text-white"
            >
              PLANER を別タブで開く
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17L17 7" /><path d="M8 7h9v9" />
              </svg>
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>
