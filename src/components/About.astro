---
import SectionHeading from './SectionHeading.astro';

const points = [
  {
    no: '01',
    key: '誰に',
    title: 'オフマーケットを開拓したい事業者へ',
    body: '不動産デベロッパー・仲介、再生可能エネルギー事業者、店舗開発など、市場に出ていない土地（オフマーケット）を能動的に仕入れたい企業が対象です。',
  },
  {
    no: '02',
    key: '何を',
    title: '衛星×AIで地権者と直接つながる',
    body: 'JAXA由来のクレータ解析技術を応用した不動産探査AIで、空き地・古家・田畑などを全国約7,300万件のデータベースから抽出。登記情報と連携し所有者まで特定します。',
  },
  {
    no: '03',
    key: 'どのように',
    title: '探索 × 行動管理 × アプローチで一気通貫',
    body: '候補地の探索、営業メンバーの行動可視化、謄本取得・DM発送の代行までをワンストップで提供。仕入れの初動から成約までを伴走支援します。',
  },
];
---

<section id="about" class="border-b border-border py-[var(--spacing-section)]">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <SectionHeading
      eyebrow="About WHERE"
      title="WHEREとは"
      lead="「誰に・何を・どのように」提供するサービスなのかを、3つの観点で整理しました。"
    />

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        points.map((p) => (
          <div class="reveal flex flex-col rounded-card border border-border bg-white p-7 shadow-feather">
            <div class="flex items-center gap-3">
              <span class="text-2xl font-semibold tracking-tight text-signal">{p.no}</span>
              <span class="rounded-badge bg-sky px-2.5 py-1 text-[12px] font-semibold text-action">{p.key}</span>
            </div>
            <h3 class="mt-5 text-[17px] font-semibold leading-snug text-graphite">{p.title}</h3>
            <p class="mt-3 text-[14px] leading-relaxed text-ash">{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
