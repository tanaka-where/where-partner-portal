---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<div class="reveal max-w-3xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="heading mt-3 text-[clamp(1.6rem,3.6vw,2.4rem)]">{title}</h2>
  {lead && <p class="mt-4 text-[15px] leading-relaxed text-ash md:text-base">{lead}</p>}
</div>
