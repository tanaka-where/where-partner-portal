---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  /** 黒背景セクションで使う場合 true */
  dark?: boolean;
}
const { eyebrow, title, lead, dark = false } = Astro.props;
---

<div class="reveal max-w-3xl">
  <p class={`eyebrow ${dark ? 'text-white/55' : ''}`}>{eyebrow}</p>
  <h2
    class={`mt-4 text-[clamp(1.8rem,4vw,2.7rem)] font-semibold leading-tight tracking-tight ${
      dark ? 'text-white' : 'text-navy'
    }`}
  >
    {title}
  </h2>
  {
    lead && (
      <p class={`mt-5 text-base leading-relaxed md:text-lg ${dark ? 'text-white/70' : 'text-offblack'}`}>
        {lead}
      </p>
    )
  }
</div>
