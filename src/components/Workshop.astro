---
import SectionHeading from './SectionHeading.astro';
import { config } from '../site.config';

const endpoint = config.formEndpoint;
---

<section id="workshop" class="bg-navy py-[var(--spacing-section)] text-white">
  <div class="mx-auto max-w-3xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Workshop"
      title="勉強会のお申し込み"
      lead="WHEREの活用を深める勉強会へのお申し込みはこちらから。担当よりご連絡します。"
      dark
    />

    <div class="reveal mt-12">
      {
        endpoint ? (
          <form data-workshop-form class="space-y-6" novalidate>
            <div class="grid gap-6 md:grid-cols-2">
              <label class="block">
                <span class="mb-2 block text-sm text-white/80">お名前 <span class="text-electric">*</span></span>
                <input name="name" required type="text" autocomplete="name"
                  class="w-full border border-white/20 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 focus:border-white focus:outline-none" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm text-white/80">会社名・団体名 <span class="text-electric">*</span></span>
                <input name="company" required type="text" autocomplete="organization"
                  class="w-full border border-white/20 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 focus:border-white focus:outline-none" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm text-white/80">メールアドレス <span class="text-electric">*</span></span>
                <input name="email" required type="email" autocomplete="email"
                  class="w-full border border-white/20 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 focus:border-white focus:outline-none" />
              </label>
              <label class="block">
                <span class="mb-2 block text-sm text-white/80">電話番号（任意）</span>
                <input name="phone" type="tel" autocomplete="tel"
                  class="w-full border border-white/20 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 focus:border-white focus:outline-none" />
              </label>
            </div>
            <label class="block">
              <span class="mb-2 block text-sm text-white/80">希望テーマ・ご質問（任意）</span>
              <textarea name="message" rows="4"
                class="w-full border border-white/20 bg-white/[0.04] px-4 py-3 text-white placeholder-white/30 focus:border-white focus:outline-none"></textarea>
            </label>

            <!-- スパム対策（ボットが埋める囮。人間には不可視） -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"
              class="absolute -left-[9999px] h-0 w-0" aria-hidden="true" />

            <div class="flex items-center gap-4">
              <button type="submit" data-submit
                class="inline-flex items-center gap-2 bg-white px-8 py-3.5 text-sm font-semibold text-navy transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-60">
                申し込む
              </button>
              <p data-form-msg class="text-sm text-white/70" role="status" aria-live="polite"></p>
            </div>
          </form>
        ) : (
          <div class="rounded-sm border border-dashed border-white/25 bg-white/[0.03] px-6 py-12 text-center">
            <p class="font-display text-xl">申込フォーム接続待ち</p>
            <p class="mx-auto mt-3 max-w-md text-sm text-white/70">
              GAS ウェブアプリをデプロイし、取得した /exec URL を
              <code class="rounded bg-white/10 px-1.5 py-0.5">site.config.ts</code> の
              <code class="rounded bg-white/10 px-1.5 py-0.5">formEndpoint</code> に設定すると、ここにフォームが表示されます。
            </p>
          </div>
        )
      }
    </div>
  </div>

  {/* 送信先：CORS を避けるため hidden iframe をターゲットに POST する */}
  <iframe name="workshop_sink" title="送信先" class="hidden" aria-hidden="true"></iframe>
</section>

{
  endpoint && (
    <script define:vars={{ endpoint }}>
      const form = document.querySelector('[data-workshop-form]');
      const msg = document.querySelector('[data-form-msg]');
      const btn = document.querySelector('[data-submit]');
      let submitting = false;

      form?.setAttribute('action', endpoint);
      form?.setAttribute('method', 'POST');
      form?.setAttribute('target', 'workshop_sink');

      const sink = document.querySelector('iframe[name="workshop_sink"]');
      sink?.addEventListener('load', () => {
        if (!submitting) return; // 初回ロードは無視
        submitting = false;
        if (btn) btn.disabled = false;
        if (msg) {
          msg.textContent = 'お申し込みを受け付けました。担当よりご連絡します。';
          msg.className = 'text-sm text-white';
        }
        form?.reset();
      });

      form?.addEventListener('submit', (e) => {
        // ハニーポットが埋まっていたら送信しない
        if (form.querySelector('input[name="_gotcha"]')?.value) {
          e.preventDefault();
          return;
        }
        if (!form.checkValidity()) {
          e.preventDefault();
          form.reportValidity();
          return;
        }
        submitting = true;
        if (btn) btn.disabled = true;
        if (msg) {
          msg.textContent = '送信中…';
          msg.className = 'text-sm text-white/70';
        }
        // ネイティブ送信に任せる（target=iframe）。例外時のフォールバック。
        setTimeout(() => {
          if (submitting) {
            submitting = false;
            if (btn) btn.disabled = false;
            if (msg) {
              msg.textContent = '送信に時間がかかっています。通信環境をご確認ください。';
              msg.className = 'text-sm text-white/70';
            }
          }
        }, 15000);
      });
    </script>
  )
}
