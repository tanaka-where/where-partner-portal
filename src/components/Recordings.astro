---
import SectionHeading from './SectionHeading.astro';
---

<section id="recordings" class="border-b border-border bg-sky py-[var(--spacing-section)]">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <SectionHeading
      eyebrow="How-to"
      title="操作説明の録画"
      lead="実際の操作手順を録画でご確認いただけるよう準備中です。"
    />

    <div class="reveal mt-12 flex flex-col items-center justify-center rounded-image border border-dashed border-hairline bg-white px-6 py-20 text-center">
      <span class="rounded-full bg-sky px-4 py-1.5 text-[12px] font-semibold tracking-widest text-signal">
        COMING SOON
      </span>
      <p class="mt-5 text-[15px] text-ash">操作説明の録画は近日公開予定です。</p>
    </div>
  </div>
</section>
