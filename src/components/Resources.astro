---
import SectionHeading from './SectionHeading.astro';
---

<section id="resources" class="bg-white py-[var(--spacing-section)]">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <SectionHeading
      eyebrow="Resources"
      title="資料各種"
      lead="概要資料・操作マニュアル・ペライチチラシなど、紹介先にそのまま渡せる最新ファイルをまとめています。スプレッドシートを更新すれば即時反映されます。"
    />

    <div class="reveal mt-12" data-resources>
      <!-- カテゴリ別フィルタ -->
      <div class="mb-8 flex flex-wrap gap-2" data-resources-filter></div>
      <!-- カード描画先 -->
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3" data-resources-list>
        <p class="col-span-full text-sm text-gray-medium" data-resources-status>
          読み込み中…
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { fetchSheet, esc, safeUrl } from '../lib/sheet';
  import { config } from '../site.config';

  type Item = {
    category: string;
    title: string;
    description: string;
    type: string;
    url: string;
    updated: string;
  };

  const listEl = document.querySelector('[data-resources-list]');
  const filterEl = document.querySelector('[data-resources-filter]');
  const statusEl = document.querySelector('[data-resources-status]');
  let items: Item[] = [];
  let active = 'すべて';

  function typeIcon(t: string): string {
    const s = (t || '').toLowerCase();
    if (s.includes('pdf')) return 'PDF';
    if (s.includes('スライド') || s.includes('slide')) return 'SLIDE';
    if (s.includes('動画') || s.includes('video')) return 'VIDEO';
    if (s.includes('チラシ') || s.includes('flyer')) return 'FLYER';
    return 'DOC';
  }

  function render() {
    if (!listEl) return;
    const shown = items.filter((i) => active === 'すべて' || i.category === active);
    if (!shown.length) {
      listEl.innerHTML =
        '<p class="col-span-full text-sm text-gray-medium">該当する資料がありません。</p>';
      return;
    }
    listEl.innerHTML = shown
      .map((i) => {
        const url = safeUrl(i.url);
        const tag = typeIcon(i.type);
        const card = `
          <span class="flex items-center justify-between">
            <span class="text-[11px] font-semibold tracking-wider text-electric">${tag}</span>
            ${i.updated ? `<span class="text-[11px] text-gray-medium">${esc(i.updated)}</span>` : ''}
          </span>
          <span class="mt-4 block text-base font-semibold text-navy">${esc(i.title)}</span>
          ${i.description ? `<span class="mt-2 block text-sm leading-relaxed text-offblack/70">${esc(i.description)}</span>` : ''}
          <span class="mt-5 inline-flex items-center gap-1 text-sm font-medium ${url ? 'text-electric' : 'text-gray-medium'}">
            ${url ? '開く →' : 'リンク未設定'}
          </span>`;
        return url
          ? `<a href="${url}" target="_blank" rel="noopener" class="flex flex-col border border-border bg-white p-6 transition-all hover:-translate-y-0.5 hover:border-navy hover:shadow-md">${card}</a>`
          : `<div class="flex flex-col border border-border bg-white p-6">${card}</div>`;
      })
      .join('');
  }

  function renderFilters() {
    if (!filterEl) return;
    const cats = ['すべて', ...Array.from(new Set(items.map((i) => i.category).filter(Boolean)))];
    filterEl.innerHTML = cats
      .map(
        (c) =>
          `<button type="button" data-cat="${esc(c)}" class="rounded-full border px-4 py-1.5 text-sm transition-colors ${
            c === active ? 'border-navy bg-navy text-white' : 'border-border text-offblack hover:border-navy'
          }">${esc(c)}</button>`,
      )
      .join('');
    filterEl.querySelectorAll('button').forEach((b) =>
      b.addEventListener('click', () => {
        active = b.getAttribute('data-cat') || 'すべて';
        renderFilters();
        render();
      }),
    );
  }

  async function init() {
    if (!config.sheets.resources) {
      if (statusEl)
        statusEl.textContent =
          'スプレッドシート未設定です（site.config.ts の sheets.resources を設定してください）。';
      return;
    }
    try {
      const rows = await fetchSheet(config.sheets.resources);
      items = rows.map((r) => ({
        category: r['category'] || r['カテゴリ'] || '',
        title: r['title'] || r['タイトル'] || '',
        description: r['description'] || r['説明'] || '',
        type: r['type'] || r['種別'] || '',
        url: r['url'] || r['URL'] || r['リンク'] || '',
        updated: r['updated'] || r['更新日'] || '',
      }));
      renderFilters();
      render();
    } catch (e) {
      if (statusEl) statusEl.textContent = '資料の読み込みに失敗しました。時間をおいて再読み込みしてください。';
    }
  }

  init();
</script>
