---
import SectionHeading from './SectionHeading.astro';
import { resources } from '../data/resources';

const base = import.meta.env.BASE_URL;
---

<section id="resources" class="border-b border-border py-[var(--spacing-section)]">
  <div class="mx-auto max-w-[1200px] px-5 md:px-8">
    <SectionHeading
      eyebrow="Resources"
      title="資料ダウンロード"
      lead="紹介先にそのままお渡しいただける、WHEREのサービス資料です。"
    />

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        resources.map((r) => {
          const href = `${base}${r.file}`;
          return (
            <a
              href={href}
              target="_blank"
              rel="noopener"
              class="reveal group flex flex-col rounded-card border border-border bg-white p-7 shadow-feather transition-all hover:-translate-y-0.5 hover:shadow-feature"
            >
              <div class="flex items-center justify-between">
                <span class="rounded-badge border border-signal/30 px-2 py-0.5 text-[11px] font-semibold tracking-wide text-signal">
                  {r.type}
                </span>
                {r.pages && <span class="text-[11px] text-fog">{r.pages}</span>}
              </div>
              <h3 class="mt-5 text-[16px] font-semibold leading-snug text-graphite">{r.title}</h3>
              <p class="mt-2.5 flex-1 text-[14px] leading-relaxed text-ash">{r.description}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-[14px] font-medium text-signal">
                ダウンロード
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 3v12" /><path d="M7 10l5 5 5-5" /><path d="M5 21h14" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
