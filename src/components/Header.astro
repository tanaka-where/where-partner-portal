---
const nav = [
  { label: 'WHEREとは', href: '#about' },
  { label: '資料', href: '#resources' },
  { label: 'PLANER', href: '#planer' },
  { label: '動画', href: '#media' },
  { label: '導入事例', href: '#cases' },
  { label: 'ニュース', href: '#news' },
];
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-border bg-canvas/85 backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-[1200px] items-center justify-between px-5 md:px-8">
    <a href="#main" class="flex items-center gap-2.5">
      <svg width="24" height="24" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <circle cx="16" cy="16" r="15" stroke="#0f1f3d" stroke-width="1.4" />
        <path d="M8 13l4.5 8L16 9l3.5 12L24 13" stroke="#145aff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </svg>
      <span class="flex items-baseline gap-2">
        <span class="text-[17px] font-semibold tracking-tight text-ink">WHERE</span>
        <span class="hidden text-[12px] font-medium text-ash sm:inline">Partner Portal</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="メインナビゲーション">
      {
        nav.map((item) => (
          <a href={item.href} class="text-[13px] font-medium text-slate transition-colors hover:text-signal">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="hidden rounded-input border border-action px-4 py-2 text-[13px] font-medium text-action transition-colors hover:bg-action hover:text-white sm:inline-block"
      >
        面談を申し込む
      </a>
      <button
        type="button"
        class="inline-flex items-center justify-center p-2 text-graphite lg:hidden"
        aria-label="メニューを開く"
        aria-expanded="false"
        data-menu-toggle
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>

  <nav class="hidden border-t border-border bg-canvas px-5 pb-5 pt-1 lg:hidden" aria-label="モバイルナビゲーション" data-mobile-menu>
    {
      nav.map((item) => (
        <a href={item.href} class="block border-b border-border py-3 text-sm text-slate" data-menu-link>
          {item.label}
        </a>
      ))
    }
    <a href="#contact" class="mt-4 block rounded-input border border-action px-4 py-2.5 text-center text-sm font-medium text-action" data-menu-link>
      面談を申し込む
    </a>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => setOpen(Boolean(menu?.classList.contains('hidden'))));
  document.querySelectorAll('[data-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
</script>
