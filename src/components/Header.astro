---
import { config } from '../site.config';

const nav = [
  { label: 'WHEREとは', href: '#about' },
  { label: '対象ユーザー', href: '#persona' },
  { label: 'PLANER', href: '#planer' },
  { label: '資料', href: '#resources' },
  { label: '操作録画', href: '#videos' },
  { label: '事例・更新', href: '#updates' },
  { label: '勉強会申込', href: '#workshop' },
];
---

<header
  class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-black/85 backdrop-blur-md"
  data-header
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 md:px-8">
    <a href="#main" class="font-display text-lg tracking-wide text-white">
      {config.siteName}
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="メインナビゲーション">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-[13px] text-white/70 transition-colors hover:text-white"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- モバイル：メニュー開閉 -->
    <button
      type="button"
      class="inline-flex items-center justify-center p-2 text-white lg:hidden"
      aria-label="メニューを開く"
      aria-expanded="false"
      data-menu-toggle
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <line x1="3" y1="7" x2="21" y2="7"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="17" x2="21" y2="17"></line>
      </svg>
    </button>
  </div>

  <!-- モバイルメニュー -->
  <nav
    class="hidden border-t border-white/10 bg-black px-5 pb-6 pt-2 lg:hidden"
    aria-label="モバイルナビゲーション"
    data-mobile-menu
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="block border-b border-white/5 py-3 text-sm text-white/80"
          data-menu-link
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]');
  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  };
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.contains('hidden');
    setOpen(Boolean(open));
  });
  document.querySelectorAll('[data-menu-link]').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });
</script>
