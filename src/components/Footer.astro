---
import { config } from '../site.config';
---

<footer class="border-t border-white/10 bg-black text-white">
  <div class="mx-auto max-w-6xl px-5 py-16 md:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="font-display text-2xl tracking-wide">{config.siteName}</p>
        <p class="mt-3 max-w-md text-sm text-white/60">{config.description}</p>
      </div>
      <div class="flex flex-col gap-2 text-sm text-white/70">
        <a href={config.links.whereWebsite} target="_blank" rel="noopener" class="hover:text-white">
          WHERE 公式サイト ↗
        </a>
        <a href={`mailto:${config.contactEmail}`} class="hover:text-white">
          お問い合わせ：{config.contactEmail}
        </a>
      </div>
    </div>
    <div class="mt-12 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-white/40 md:flex-row md:justify-between">
      <p>&copy; 株式会社WHERE — パートナー向け情報ポータル</p>
      <p>本ポータルはパートナー担当者向けの限定共有用です。取り扱いにご注意ください。</p>
    </div>
  </div>
</footer>
