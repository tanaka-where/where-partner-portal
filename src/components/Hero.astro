---
// インフォメーション主体のヒーロー（マーケコピーは置かない）
const quickLinks = [
  { label: 'WHEREとは', href: '#about' },
  { label: '資料ダウンロード', href: '#resources' },
  { label: 'PLANER', href: '#planer' },
  { label: '導入事例・ニュース', href: '#cases' },
  { label: '面談申し込み', href: '#contact' },
];
const facts = [
  { v: 'JAXA', l: '認定スタートアップ' },
  { v: '約7,300万件', l: '不動産データベース' },
  { v: '200社', l: '導入突破' },
];
---

<section class="relative overflow-hidden border-b border-border">
  <!-- ソフトな青のラジアルウォッシュ（ヒーロー内で完結） -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background:radial-gradient(80% 90% at 78% 8%, #e8eeff 0%, rgba(240,244,254,0.6) 38%, #fcfcfc 72%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1200px] px-5 pb-16 pt-28 md:px-8 md:pb-24 md:pt-36">
    <p class="eyebrow">WHERE Partner Portal</p>
    <h1 class="display mt-5 max-w-3xl text-[clamp(2rem,5.2vw,3.5rem)]">
      WHEREポータルサイト
    </h1>
    <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-slate md:text-lg">
      パートナー企業様に向けた各種資料を取り揃えています。<br class="hidden sm:block" />
      サービス資料・PLANER・導入事例・ニュース・面談申し込みをこのページからご利用いただけます。
    </p>

    <!-- セクションへのクイックリンク -->
    <div class="mt-9 flex flex-wrap gap-2.5">
      {
        quickLinks.map((q) => (
          <a
            href={q.href}
            class="rounded-full border border-border bg-white px-4 py-2 text-[13px] font-medium text-slate shadow-feather transition-colors hover:border-signal hover:text-signal"
          >
            {q.label}
          </a>
        ))
      }
    </div>

    <!-- 事実ベースの数値（装飾的コピーではなく情報） -->
    <div class="mt-12 grid max-w-2xl grid-cols-3 gap-4">
      {
        facts.map((f) => (
          <div class="rounded-card border border-border bg-white px-4 py-4 shadow-feather">
            <div class="text-[clamp(1.1rem,3vw,1.6rem)] font-semibold tracking-tight text-ink">{f.v}</div>
            <div class="mt-1 text-[12px] text-ash">{f.l}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
